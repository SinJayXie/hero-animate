{
  "name": "hero-animate",
  "version": "1.0.2",
  "type": "module",
  "description": "iOS 风格「图标 ⇄ 窗口」形变转场，框架无关核心 + Vue/React 组件",
  "author": "SinJayXie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SinJayXie/hero-animate.git"
  },
  "homepage": "https://sinjayxie.github.io/hero-animate/",
  "bugs": {
    "url": "https://github.com/SinJayXie/hero-animate/issues"
  },
  "keywords": [
    "hero",
    "hero-transition",
    "shared-element",
    "transition",
    "animation",
    "spring",
    "animejs",
    "vue",
    "react",
    "modal",
    "dialog",
    "popover"
  ],
  "sideEffects": [
    "./src/**",
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.15.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "docs:build": "vite build --config vite.docs.config.ts",
    "docs:preview": "vite preview --config vite.docs.config.ts --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "animejs": "^4.5.0",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "animejs": "^4.5.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.44"
  }
}
